rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ---------- MODERATION (Phase 5) ----------

    // An admin is anyone with a document in the "admins" collection.
    // Only YOU can add one, by hand in the Firebase console. The app can never do it.
    function isAdmin() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Banned people can't post, comment, message, send requests or report.
    function notBanned() {
      return !exists(/databases/$(database)/documents/banned/$(request.auth.uid));
    }

    // ---------- FRIENDS (Phase 3) ----------

    // Are a and b accepted friends? (The friendship doc id is the two user ids
    // joined with "_", in either order, so we check both.)
    function areFriends(a, b) {
      return (exists(/databases/$(database)/documents/friendships/$(a + '_' + b))
              && get(/databases/$(database)/documents/friendships/$(a + '_' + b)).data.status == 'accepted')
          || (exists(/databases/$(database)/documents/friendships/$(b + '_' + a))
              && get(/databases/$(database)/documents/friendships/$(b + '_' + a)).data.status == 'accepted');
    }

    // You can see your own posts and your friends' posts.
    function canSee(authorId) {
      return authorId == request.auth.uid || areFriends(request.auth.uid, authorId);
    }

    function canSeePost(postId) {
      return canSee(get(/databases/$(database)/documents/posts/$(postId)).data.authorId);
    }

    // ---------- CHAT + NOTIFICATIONS helpers (Phase 4) ----------

    // A chat id is the two user ids joined with "_", so the id itself tells us who is in it.
    function chatMember(chatId) {
      return request.auth.uid in chatId.split('_');
    }

    function chatFriends(chatId) {
      return areFriends(chatId.split('_')[0], chatId.split('_')[1]);
    }

    // A new notification: sent BY me, about a real like/comment on the recipient's post,
    // or about a real friend request between us.
    function validNotif(d, recipient) {
      return d.keys().hasOnly(['actorId', 'type', 'postId', 'read', 'createdAt'])
        && d.keys().hasAll(['actorId', 'type', 'postId', 'read', 'createdAt'])
        && d.actorId == request.auth.uid
        && recipient != request.auth.uid
        && d.read == false
        && d.createdAt == request.time
        && d.postId is string
        && (
          ((d.type == 'like' || d.type == 'comment')
            && exists(/databases/$(database)/documents/posts/$(d.postId))
            && get(/databases/$(database)/documents/posts/$(d.postId)).data.authorId == recipient
            && canSee(recipient))
          ||
          ((d.type == 'friend_request' || d.type == 'friend_accept')
            && d.postId == ''
            && (exists(/databases/$(database)/documents/friendships/$(request.auth.uid + '_' + recipient))
                || exists(/databases/$(database)/documents/friendships/$(recipient + '_' + request.auth.uid))))
        );
    }

    // A new friend request: sent by me, pending, to a real user.
    function validRequest(d, pairId) {
      return d.keys().hasOnly(['requesterId', 'addresseeId', 'members', 'status', 'createdAt'])
        && d.keys().hasAll(['requesterId', 'addresseeId', 'members', 'status', 'createdAt'])
        && d.requesterId == request.auth.uid
        && d.addresseeId is string && d.addresseeId != d.requesterId
        && d.members.size() == 2
        && d.members.hasAll([d.requesterId, d.addresseeId])
        && (pairId == d.requesterId + '_' + d.addresseeId || pairId == d.addresseeId + '_' + d.requesterId)
        && d.status == 'pending'
        && d.createdAt == request.time
        && exists(/databases/$(database)/documents/users/$(d.addresseeId))
        && !exists(/databases/$(database)/documents/users/$(d.addresseeId)/blocked/$(request.auth.uid))
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocked/$(d.addresseeId))
        && notBanned();
    }

    match /friendships/{pairId} {
      // only the two people involved can see it
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && validRequest(request.resource.data, pairId);
      // only the person who RECEIVED the request can accept it
      allow update: if signedIn()
        && resource.data.addresseeId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'accepted';
      // either person can delete (decline, cancel request, unfriend)
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
    }

    // ---------- PROFILES (Phase 1) ----------

    // A profile must have exactly these fields, with valid values.
    function validProfile(d) {
      return d.keys().hasOnly(['username', 'name', 'bio', 'avatarUrl', 'coverUrl', 'createdAt'])
        && d.keys().hasAll(['username', 'name', 'bio', 'avatarUrl', 'coverUrl', 'createdAt'])
        && d.username is string && d.username.matches('^[a-z0-9_]{3,20}$')
        && d.name is string && d.name.size() > 0 && d.name.size() <= 50
        && d.bio is string && d.bio.size() <= 160
        && d.avatarUrl is string && d.coverUrl is string
        && d.createdAt is timestamp;
    }

    // users/{uid}: anyone signed in can read (needed for search); ONLY the owner can create or edit.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid && validProfile(request.resource.data);
      allow update: if signedIn() && request.auth.uid == uid
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      // users/{uid}/notifications/{nid}: only you can read them; others can only ADD ones about you.
      match /notifications/{nid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && validNotif(request.resource.data, uid);
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read == true;
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      // users/{uid}/saved/{postId}: your private list of saved posts.
      match /saved/{savedPostId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['savedAt'])
          && request.resource.data.savedAt == request.time;
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      // users/{uid}/blocked/{blockedId}: only you can see or change YOUR block list.
      // (The rules for friend requests peek at it to stop blocked people, without showing it to them.)
      match /blocked/{blockedId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid
          && blockedId != uid
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    // usernames/{username}: makes usernames unique. You can only claim a free name,
    // and only if it matches the username on your own profile.
    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn()
        && username.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---------- POSTS (Phase 2, now friends-only) ----------

    // A new post: your own id, valid text/photo, server time, and zero counts.
    function validNewPost(d) {
      return d.keys().hasOnly(['authorId', 'text', 'imageUrl', 'createdAt', 'likeCount', 'commentCount'])
        && d.keys().hasAll(['authorId', 'text', 'imageUrl', 'createdAt', 'likeCount', 'commentCount'])
        && d.authorId == request.auth.uid
        && d.text is string && d.text.size() <= 2000
        && d.imageUrl is string
        && (d.text.size() > 0 || d.imageUrl.size() > 0)
        && d.createdAt == request.time
        && d.likeCount == 0 && d.commentCount == 0;
    }

    // The owner can change ONLY the text (and the edited time).
    function isOwnerEdit() {
      let n = request.resource.data;
      return resource.data.authorId == request.auth.uid
        && n.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
        && n.text is string && n.text.size() <= 2000
        && (n.text.size() > 0 || n.imageUrl.size() > 0)
        && n.editedAt == request.time;
    }

    // People who can see a post can bump its like/comment counters, but only by 1 at a time.
    function isCounterUpdate() {
      let n = request.resource.data;
      let o = resource.data;
      return n.diff(o).affectedKeys().hasOnly(['likeCount', 'commentCount'])
        && n.likeCount >= 0 && n.commentCount >= 0
        && math.abs(n.likeCount - o.likeCount) <= 1
        && math.abs(n.commentCount - o.commentCount) <= 1;
    }

    // Rate limit: you can post at most once every 10 seconds.
    // The app saves a "last post" time in rateLimits/{you} together with every post;
    // the post is only accepted if that time moved forward by 10+ seconds.
    function postRateOk() {
      return getAfter(/databases/$(database)/documents/rateLimits/$(request.auth.uid)).data.lastPostAt == request.time
        && (!exists(/databases/$(database)/documents/rateLimits/$(request.auth.uid))
            || request.time > get(/databases/$(database)/documents/rateLimits/$(request.auth.uid)).data.lastPostAt + duration.value(10, 's'));
    }

    // rateLimits/{uid}: you can only write your OWN timer, and only forward by 10+ seconds.
    match /rateLimits/{rateUid} {
      allow create: if signedIn() && request.auth.uid == rateUid
        && request.resource.data.keys().hasOnly(['lastPostAt'])
        && request.resource.data.lastPostAt == request.time;
      allow update: if signedIn() && request.auth.uid == rateUid
        && request.resource.data.keys().hasOnly(['lastPostAt'])
        && request.resource.data.lastPostAt == request.time
        && request.time > resource.data.lastPostAt + duration.value(10, 's');
      allow read, delete: if false;
    }

    match /posts/{postId} {
      allow read: if signedIn() && (canSee(resource.data.authorId) || isAdmin());
      allow create: if signedIn() && validNewPost(request.resource.data) && notBanned() && postRateOk();
      allow update: if signedIn()
        && (isOwnerEdit() || (canSee(resource.data.authorId) && isCounterUpdate()));
      allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());

      // posts/{postId}/likes/{uid}: the doc id is the liker, so you can't like twice
      match /likes/{likerId} {
        allow read: if signedIn() && canSeePost(postId);
        allow create: if signedIn() && request.auth.uid == likerId
          && canSeePost(postId)
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if signedIn() && request.auth.uid == likerId;
      }

      // posts/{postId}/comments/{commentId}: only the author can delete theirs
      match /comments/{commentId} {
        allow read: if signedIn() && canSeePost(postId);
        allow create: if signedIn()
          && canSeePost(postId)
          && notBanned()
          && request.resource.data.keys().hasOnly(['authorId', 'text', 'createdAt'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
      }
    }

    // ---------- REELS (Phase 8) ----------

    // A new reel: your own id, a Cloudinary video link, a short caption, server time, zero counts.
    function validNewReel(d) {
      return d.keys().hasOnly(['authorId', 'videoUrl', 'caption', 'createdAt', 'likeCount', 'commentCount'])
        && d.keys().hasAll(['authorId', 'videoUrl', 'caption', 'createdAt', 'likeCount', 'commentCount'])
        && d.authorId == request.auth.uid
        && d.videoUrl is string && d.videoUrl.size() <= 500
        && d.videoUrl.matches('^https://res[.]cloudinary[.]com/.*')
        && d.caption is string && d.caption.size() <= 150
        && d.createdAt == request.time
        && d.likeCount == 0 && d.commentCount == 0;
    }

    // Rate limit: you can post at most one reel every 30 seconds (same idea as for posts).
    function reelRateOk() {
      return getAfter(/databases/$(database)/documents/reelLimits/$(request.auth.uid)).data.lastReelAt == request.time
        && (!exists(/databases/$(database)/documents/reelLimits/$(request.auth.uid))
            || request.time > get(/databases/$(database)/documents/reelLimits/$(request.auth.uid)).data.lastReelAt + duration.value(30, 's'));
    }

    match /reelLimits/{rateUid} {
      allow create: if signedIn() && request.auth.uid == rateUid
        && request.resource.data.keys().hasOnly(['lastReelAt'])
        && request.resource.data.lastReelAt == request.time;
      allow update: if signedIn() && request.auth.uid == rateUid
        && request.resource.data.keys().hasOnly(['lastReelAt'])
        && request.resource.data.lastReelAt == request.time
        && request.time > resource.data.lastReelAt + duration.value(30, 's');
      allow read, delete: if false;
    }

    // reels/{reelId}: reels are PUBLIC to everyone signed in (like Facebook Reels).
    // Only the author (or an admin) can delete one. Nobody can edit one.
    match /reels/{reelId} {
      allow read: if signedIn();
      allow create: if signedIn() && validNewReel(request.resource.data) && notBanned() && reelRateOk();
      allow update: if signedIn() && isCounterUpdate();
      allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());

      match /likes/{likerId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid == likerId
          && exists(/databases/$(database)/documents/reels/$(reelId))
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if signedIn() && request.auth.uid == likerId;
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && exists(/databases/$(database)/documents/reels/$(reelId))
          && notBanned()
          && request.resource.data.keys().hasOnly(['authorId', 'text', 'createdAt'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
      }
    }

    // ---------- MARKETPLACE (Phase 10) ----------

    // A new listing: yours, with a photo from Cloudinary, a price in naira, and valid text.
    function validListing(d) {
      return d.keys().hasOnly(['sellerId', 'title', 'price', 'description', 'category', 'location', 'contact', 'imageUrl', 'sold', 'createdAt'])
        && d.keys().hasAll(['sellerId', 'title', 'price', 'description', 'category', 'location', 'contact', 'imageUrl', 'sold', 'createdAt'])
        && d.sellerId == request.auth.uid
        && d.title is string && d.title.size() > 0 && d.title.size() <= 80
        && d.price is int && d.price >= 0 && d.price <= 1000000000
        && d.description is string && d.description.size() <= 1000
        && d.category in ['Phones', 'Fashion', 'Electronics', 'Home', 'Vehicles', 'Food', 'Other']
        && d.location is string && d.location.size() <= 60
        && d.contact is string && d.contact.size() <= 20 && d.contact.matches('^[0-9+]*$')
        && d.imageUrl is string && d.imageUrl.size() <= 500
        && d.imageUrl.matches('^https://res[.]cloudinary[.]com/.*')
        && d.sold == false
        && d.createdAt == request.time;
    }

    // listings/{id}: anyone signed in can browse. Only the seller can change "sold" or delete (admins can delete too).
    match /listings/{listingId} {
      allow read: if signedIn();
      allow create: if signedIn() && validListing(request.resource.data) && notBanned();
      allow update: if signedIn() && resource.data.sellerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sold'])
        && request.resource.data.sold is bool;
      allow delete: if signedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    // ---------- GROUPS (Phase 10) ----------

    // A new group or page: yours, with a name and short text.
    function validCommunity(d) {
      return d.keys().hasOnly(['ownerId', 'name', 'description', 'category', 'createdAt'])
        && d.keys().hasAll(['ownerId', 'name', 'description', 'category', 'createdAt'])
        && d.ownerId == request.auth.uid
        && d.name is string && d.name.size() > 0 && d.name.size() <= 50
        && d.description is string && d.description.size() <= 300
        && d.category is string && d.category.size() <= 30
        && d.createdAt == request.time;
    }

    function isGroupMember(gid) {
      return exists(/databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid));
    }

    // groups/{gid}: anyone can see a group exists and join it; only members can read its posts.
    match /groups/{gid} {
      allow read: if signedIn();
      allow create: if signedIn() && validCommunity(request.resource.data) && notBanned();
      allow update: if false;
      allow delete: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());

      match /members/{memberId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid == memberId && notBanned()
          && request.resource.data.keys().hasOnly(['joinedAt'])
          && request.resource.data.joinedAt == request.time;
        allow update: if false;
        allow delete: if signedIn() && request.auth.uid == memberId;
      }

      match /posts/{gpostId} {
        allow read: if signedIn() && (isGroupMember(gid) || isAdmin());
        allow create: if signedIn() && isGroupMember(gid) && validNewPost(request.resource.data) && notBanned() && postRateOk();
        allow update: if signedIn() && isGroupMember(gid) && (isOwnerEdit() || isCounterUpdate());
        allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());

        match /likes/{likerId} {
          allow read: if signedIn() && isGroupMember(gid);
          allow create: if signedIn() && request.auth.uid == likerId && isGroupMember(gid)
            && request.resource.data.keys().hasOnly(['createdAt'])
            && request.resource.data.createdAt == request.time;
          allow update: if false;
          allow delete: if signedIn() && request.auth.uid == likerId;
        }

        match /comments/{commentId} {
          allow read: if signedIn() && isGroupMember(gid);
          allow create: if signedIn() && isGroupMember(gid) && notBanned()
            && request.resource.data.keys().hasOnly(['authorId', 'text', 'createdAt'])
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 500
            && request.resource.data.createdAt == request.time;
          allow update: if false;
          allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
        }
      }
    }

    // ---------- PAGES (Phase 10) ----------

    // pages/{pid}: anyone can see and follow a page. Only the owner can post on it.
    match /pages/{pid} {
      allow read: if signedIn();
      allow create: if signedIn() && validCommunity(request.resource.data) && notBanned();
      allow update: if false;
      allow delete: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());

      match /followers/{followerId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid == followerId && notBanned()
          && request.resource.data.keys().hasOnly(['joinedAt'])
          && request.resource.data.joinedAt == request.time;
        allow update: if false;
        allow delete: if signedIn() && request.auth.uid == followerId;
      }

      match /posts/{ppostId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && get(/databases/$(database)/documents/pages/$(pid)).data.ownerId == request.auth.uid
          && validNewPost(request.resource.data) && notBanned() && postRateOk();
        allow update: if signedIn() && (isOwnerEdit() || isCounterUpdate());
        allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());

        match /likes/{likerId} {
          allow read: if signedIn();
          allow create: if signedIn() && request.auth.uid == likerId
            && request.resource.data.keys().hasOnly(['createdAt'])
            && request.resource.data.createdAt == request.time;
          allow update: if false;
          allow delete: if signedIn() && request.auth.uid == likerId;
        }

        match /comments/{commentId} {
          allow read: if signedIn();
          allow create: if signedIn() && notBanned()
            && request.resource.data.keys().hasOnly(['authorId', 'text', 'createdAt'])
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 500
            && request.resource.data.createdAt == request.time;
          allow update: if false;
          allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
        }
      }
    }

    // ---------- EVENTS (Phase 10) ----------

    // A new event: yours, in the future, with short text.
    function validEvent(d) {
      return d.keys().hasOnly(['hostId', 'title', 'description', 'location', 'startAt', 'createdAt'])
        && d.keys().hasAll(['hostId', 'title', 'description', 'location', 'startAt', 'createdAt'])
        && d.hostId == request.auth.uid
        && d.title is string && d.title.size() > 0 && d.title.size() <= 80
        && d.description is string && d.description.size() <= 500
        && d.location is string && d.location.size() <= 100
        && d.startAt is timestamp && d.startAt > request.time
        && d.createdAt == request.time;
    }

    // events/{id}: public to everyone signed in. Only the host can delete (or an admin).
    match /events/{eventId} {
      allow read: if signedIn();
      allow create: if signedIn() && validEvent(request.resource.data) && notBanned();
      allow update: if false;
      allow delete: if signedIn() && (resource.data.hostId == request.auth.uid || isAdmin());

      // events/{id}/rsvps/{uid}: your own answer: going or interested
      match /rsvps/{rsvpUid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.auth.uid == rsvpUid && notBanned()
          && request.resource.data.keys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['going', 'interested']
          && request.resource.data.updatedAt == request.time;
        allow delete: if signedIn() && request.auth.uid == rsvpUid;
      }
    }

    // ---------- CHATS (Phase 4) ----------

    // chats/{chatId}: a private conversation between two FRIENDS
    match /chats/{chatId} {
      allow read: if signedIn() && chatMember(chatId);

      allow create: if signedIn() && chatMember(chatId) && chatFriends(chatId)
        && request.resource.data.keys().hasOnly(['members', 'lastMessage', 'lastMessageAt', 'lastSenderId', 'unread', 'lastRead'])
        && request.resource.data.keys().hasAll(['members', 'lastMessage', 'lastMessageAt', 'lastSenderId', 'unread', 'lastRead'])
        && request.resource.data.members.size() == 2
        && request.resource.data.members.hasAll(chatId.split('_'))
        && request.resource.data.lastMessage == ''
        && request.resource.data.lastSenderId == ''
        && request.resource.data.lastMessageAt == request.time;

      // the two people can update the summary and their unread/read markers, never the members
      allow update: if signedIn() && chatMember(chatId)
        && request.resource.data.members == resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastMessage', 'lastMessageAt', 'lastSenderId', 'unread', 'lastRead']);

      allow delete: if false;

      // messages can be sent only as yourself, and only while you are still friends
      match /messages/{messageId} {
        allow read: if signedIn() && chatMember(chatId);
        allow create: if signedIn() && chatMember(chatId) && chatFriends(chatId)
          && notBanned()
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // ---------- ADMINS, BANS, REPORTS (Phase 5) ----------

    // admins/{uid}: you may only check your OWN entry. Nobody can write from the app.
    match /admins/{adminId} {
      allow read: if signedIn() && request.auth.uid == adminId;
      allow write: if false;
    }

    // banned/{uid}: you can see if YOU are banned. Only admins can ban.
    match /banned/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && isAdmin()
        && request.resource.data.keys().hasOnly(['by', 'createdAt'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // A report: from me, about someone else, with a valid reason.
    function validReport(d) {
      return d.keys().hasOnly(['reporterId', 'targetType', 'targetId', 'targetUserId', 'reason', 'details', 'status', 'createdAt'])
        && d.keys().hasAll(['reporterId', 'targetType', 'targetId', 'targetUserId', 'reason', 'details', 'status', 'createdAt'])
        && d.reporterId == request.auth.uid
        && d.targetType in ['user', 'post', 'reel', 'listing']
        && d.targetId is string && d.targetId.size() > 0 && d.targetId.size() <= 100
        && d.targetUserId is string && d.targetUserId != request.auth.uid
        && d.reason in ['spam', 'harassment', 'fake', 'inappropriate', 'other']
        && d.details is string && d.details.size() <= 300
        && d.status == 'open'
        && d.createdAt == request.time;
    }

    // reports/{id}: anyone can file one; ONLY admins can read or handle them.
    match /reports/{reportId} {
      allow create: if signedIn() && notBanned() && validReport(request.resource.data);
      allow read: if signedIn() && isAdmin();
      allow update: if signedIn() && isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['resolved', 'dismissed'];
      allow delete: if false;
    }

    // Everything else stays locked.
  }
}
